{
  "name": "interleaved-study",
  "productName": "Interleaved Study",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Interleaved practice with spaced repetition for lesson documents (Tauri + Rust)",
  "scripts": {
