{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interleaved Study",
  "version": "2.0.0",
  "identifier": "local.interleaved.study.rs",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://127.0.0.1:5183",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "icons/trayTemplate.png": "trayTemplate.png", "icons/trayTemplate@2x.png": "trayTemplate@2x.png" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
